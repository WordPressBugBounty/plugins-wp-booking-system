#: includes/base/admin/calendar/views/view-ical-import-export.php:271
msgid ""
"You don't have any iCal URL's included. Use the form below to add an iCal "
"feed URL."
msgstr ""
"No tiene ninguna URL de iCal incluida. Utilice el formulario a continuación "
"para agregar una URL de fuente de iCal."

#: includes/modules/pricing/form/views/view-edit-form-tab-final-payment-success.php:22
#: includes/modules/pricing/form/views/view-edit-form-tab-final-payment-reminder.php:22
msgid ""
"You must add an Email field to the form in order to configure payment "
"reminders."
msgstr ""
"Debe agregar un campo de correo electrónico al formulario para configurar "
"recordatorios de pago."

#: includes/base/admin/form/views/view-edit-form-tab-user-notification.php:8
msgid ""
"You must add an Email field to the form in order to configure user "
"notifications."
msgstr ""
"Debe agregar un campo de correo electrónico al formulario para configurar "
"las notificaciones de usuario."

